#!/usr/bin/env sh
# loader: setup shell to source all files in ~/.shellscript/shellrc
# This script is idempotent: it replaces any previous managed block.
# It finds the first appropriate rc file for the current shell and ensures it sources ~/.shellscript/shellrc/*.

set -eu

# Download a URL to a file using curl or wget (whichever is available)
download() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" "$1"
  else
    echo "Error: Neither curl nor wget is installed." >&2
    return 3
  fi
}

DEVELOPER=0

while [ $# -gt 0 ]; do
  case "$1" in
    --developer) DEVELOPER=1 ;;
    *) echo "Error: Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

# Resolve the directory this script lives in (for --developer relative paths)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Determine shell and candidate rc files ($SHELL may be unset, e.g. in containers)
SHELL_NAME=${SHELL:-}
SHELL_NAME=${SHELL_NAME##*/}
case "$SHELL_NAME" in
  bash) RC_CANDIDATES=".bashrc .bash_profile .profile" ;;
  zsh)  RC_CANDIDATES=".zshrc .zprofile .profile" ;;
  *)    RC_CANDIDATES=".profile" ;;
esac

# Ensure the shellrc directory exists
mkdir -p "$HOME/.shellscript/shellrc"

# Ensure default setup script exists/updated: ~/.shellscript/shellrc/00-setup.sh
# This script will ensure ~/.shellscript/bin exists and is on PATH (without duplication)
SETUP="$HOME/.shellscript/shellrc/00-setup.sh"
cat > "$SETUP" <<'LOADER_SETUP'
# ~/.shellscript/shellrc/00-setup.sh - managed by shellscript.download - DO NOT CHANGE IT
# Ensure ~/.shellscript/bin exists and is in PATH
mkdir -p "$HOME/.shellscript/bin"
case ":$PATH:" in
  *":$HOME/.shellscript/bin:"*) ;;
  *) PATH="$HOME/.shellscript/bin:$PATH" ;;
esac
export PATH
LOADER_SETUP
echo "✓ $(basename $SETUP) updated!"

# Choose the first existing rc file in the list; if none exist, choose the first name
TARGET=""
for name in $RC_CANDIDATES; do
  if [ -e "$HOME/$name" ]; then
    TARGET="$HOME/$name"
    break
  fi
done
if [ -z "${TARGET:-}" ]; then
  # pick first from list
  TARGET="$HOME/${RC_CANDIDATES%% *}"
fi

BLOCK_START="# >>> loader-shellrc >>>"
BLOCK_END="# <<< loader-shellrc <<<"

# Create a temp file safely
TMP_FILE=$(mktemp "${TMPDIR:-/tmp}/loader-shellrc.XXXXXXXX")

# Strip any existing managed block
# If the target does not exist yet, the awk will fail to open; ignore errors and proceed with empty input
awk -v start="$BLOCK_START" -v end="$BLOCK_END" '
  BEGIN{inblock=0}
  $0 ~ "^"start"$" {inblock=1; next}
  $0 ~ "^"end"$" {inblock=0; next}
  inblock==0 {print}
' "$TARGET" 2>/dev/null > "$TMP_FILE" || true

# Write back the cleaned content plus the new managed block
{
  # preserve existing content
  if [ -s "$TMP_FILE" ]; then
    cat "$TMP_FILE"
    # ensure a trailing newline
    case $(tail -c1 "$TMP_FILE" 2>/dev/null || printf '\n') in "") printf "\n" ;; esac
  fi

  printf "%s\n" "$BLOCK_START"
  cat <<'LOADER_SHELLRC_BLOCK'
# Load files from ~/.shellscript/shellrc (managed by shellscript.download)
# Only load .sh files, ordered by name
if [ -d "$HOME/.shellscript/shellrc" ]; then
  # Read list via here-doc to avoid a pipeline subshell; ensure deterministic sort order
  while IFS= read -r __loader_file; do
    [ -r "$__loader_file" ] && . "$__loader_file"
  done <<EOF
$(find "$HOME/.shellscript/shellrc" -type f -name '*.sh' -print 2>/dev/null | LC_ALL=C sort)
EOF
  unset __loader_file
fi
LOADER_SHELLRC_BLOCK
  printf "%s\n" "$BLOCK_END"
} > "$TMP_FILE.new"

# Move into place
echo "✓ $(basename $TARGET) updated!"
mkdir -p "$(dirname "$TARGET")"
mv "$TMP_FILE.new" "$TARGET"
rm -f "$TMP_FILE"

# Display success message with visual separation
mkdir -p "$HOME/.shellscript/bin"
if [ "$DEVELOPER" = "1" ]; then
  cp "${SCRIPT_DIR}/../scripts/load.sh" "$HOME/.shellscript/bin/load.sh"
else
  if ! download "https://shellscript.download/scripts/load.sh" "$HOME/.shellscript/bin/load.sh"; then
    echo "Error: Failed to download 'load.sh'" >&2
    exit 3
  fi
fi
chmod a+x "$HOME/.shellscript/bin/load.sh"
echo "✓ Shell script download loader successfully installed!"

COMPLETION_DEST="$HOME/.shellscript/shellrc/01-load-completion.sh"
if [ "$DEVELOPER" = "1" ]; then
  cp "${SCRIPT_DIR}/load-completion.sh" "$COMPLETION_DEST"
else
  download "https://shellscript.download/install/load-completion.sh" "$COMPLETION_DEST"
fi
echo "✓ Bash completion installed!"

# Show action items with clear formatting
echo ""
echo "To complete the installation:"
echo "-----------------------------"
echo "Option 1: Close and reopen your terminal"
echo "Option 2: Apply changes immediately by running:"
echo "         source ${TARGET}"

# Add helpful hint
echo ""
echo "Tip: Use Option 2 to start using the loader right away!"
